# Cache for ''*/files/*'
uwsgi_cache_path /var/cache/nginx/cache_web_files levels=1:2 keys_zone=cache_web_files:100m inactive=60m max_size=1000m use_temp_path=off;

large_client_header_buffers 8 32k;

map $request_method $safe_method {
    default  "GET";
    HEAD     "HEAD";
}

upstream web-app {
    server web:5000 max_conns=20;
}

upstream eospublic {
    server eospublic.cern.ch:443;
    keepalive 32;
}

# Per-client rate limit for the EOS reverse proxy
limit_req_zone $binary_remote_addr zone=cod_eos:10m rate=50r/s;

# Disable cache for responses with Content-Length larger than 10000000 bytes:
# Based on https://forum.nginx.org/read.php?2,253260,253662#msg-253662
map $upstream_http_content_length $nocache {
    default 1;
    "~^[1-9]{0,7}$" 0;
}

server {
    listen 80;
    listen 443 ssl;  # FIXME remove SSL config in production
    server_name _ "";
    server_tokens off;
    charset utf-8;

    # FIXME remove SSL config in production
    ssl_certificate     /etc/ssl/localhost.crt;
    ssl_certificate_key /etc/ssl/localhost.key;

    # Configure basic logging:
    access_log /var/log/nginx/access.log combined;
    error_log /var/log/nginx/error.log error;

    # Compress HTML responses
    gzip on;
    gzip_types text/plain application/json;

    # Tell nginx to rewrite URI if the path contains uppercase characters and
    # path doesn't start with '/files/' or with `/records/`.
    # If more paths need to be excluded, add them to the selection group
    # `(files/|record/|static/|eos/)` in the regex-clause.
    # Paths must end with `/`-char.
    # Works correctly only when defined as first location block of the server.
    # Based on https://stackoverflow.com/a/11170826
    location ~ ^/(?!(\b(files/|record/|static/|eos/|glossary/)\b)).*[A-Z] {
        # Simple rewriter that rewrites everything in path to lowercase
        # and continues processing of rewritten URI with internal_redirect.
        # Doesn't update URI displayed in browser
        perl 'sub { my $r = shift; $r->internal_redirect(lc($r->uri)); }';
    }

    location /static {
        root /opt/invenio/var/instance;
        # Cache for 30 days
        expires 30d;
        # Cache-Control header
        add_header Cache-Control "public, max-age=2592000, immutable";
        # Compress
        gzip on;
        gzip_types text/css application/javascript;
    }

    # Old reverse proxy to EOS locations used from COD2 times. (Not advertised
    # much in COD3 times anymore, but still useful to have.)
    location /eos/opendata/ {
        if ($request_uri !~ "^/eos/opendata/") {
          return 403;
        }

        proxy_pass https://eospublic;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # ---- TLS to the backend --------------------------------------------
        proxy_ssl_server_name on;                    # send SNI
        proxy_ssl_name        eospublic.cern.ch;
        proxy_ssl_protocols   TLSv1.2 TLSv1.3;
        proxy_ssl_verify      on;
        proxy_ssl_verify_depth 3;   # leaf -> CERN Grid CA -> CERN Root 2
        proxy_ssl_trusted_certificate /etc/ssl/certs/CERN-Root-2.pem;
        proxy_set_header Host eospublic.cern.ch;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        # --- The interception ---
        proxy_intercept_errors on;
        error_page 301 302 303 307 308 = @follow_redirect;

        # Safety net if a redirect escapes interception.
        proxy_redirect ~^https?://[^/]+(/.*)$ $1;

        # --- Stream, don't buffer ---
        proxy_buffering         off;
        proxy_request_buffering off;
        #
        # proxy_buffer_size caps the RESPONSE HEADER nginx will read from the
        # backend, and still applies with buffering off. XRootD's 307 carries
        # the capability token in the Location header -- roughly 1.5 KB for a
        # single-replica file, more for multi-replica -- against a 4 KB default
        # page size. Too small and you get "upstream sent too big header" and
        # a 502 on that file only.
        proxy_buffer_size 32k;
        proxy_buffers     8 32k;
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;

        limit_req zone=cod_eos burst=1000 nodelay;
        limit_req_status 429;
        error_page 429 = @eos_rate_limit;
    }

    # Follow the EOS redirect (to the FST holding the file) on the server side,
    # so that clients only ever talk to this proxy.
    location @follow_redirect {
        internal;

        # Capture Location BEFORE proxy_pass overwrites $upstream_http_*.
        set $storage_target $upstream_http_location;

        # Guard: constrain what we are willing to fetch.
        #
        # This is the only thing limiting where proxy_pass can be pointed.
        # The storage hop is plain HTTP, so there is no certificate check
        # acting as an implicit allowlist -- without this, any Location the
        # backend emits gets fetched and streamed to the client, including
        # http://127.0.0.1/, link-local metadata endpoints, or anything else
        # reachable from this host.
        #
        # [EDIT] Narrow this further if you know the storage node naming
        # scheme, e.g. ^http://st-[a-z0-9-]+\.cern\.ch(:[0-9]+)?(/|$)
        #
        # The (/|$) tail is deliberate: XRootD redirects to a bare origin with
        # no path at all, e.g. "http://st-096-ee856c34.cern.ch:8443". nginx
        # then reapplies the original request URI, which is the correct
        # behaviour -- but a regex requiring a trailing slash would 502 every
        # download.
        if ($storage_target !~ "^https?://[a-z0-9-]+(\.[a-z0-9-]+)*\.cern\.ch(:[0-9]+)?(/|$)") {
            return 502 "backend sent a Location that cannot be followed\n";
        }

        # proxy_pass with a variable resolves the storage node at request
        # time, so it needs a resolver. NGINX_LOCAL_RESOLVERS is filled in at
        # container start from /etc/resolv.conf (Docker DNS, cluster DNS, ...).
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

        proxy_pass $storage_target;
        proxy_http_version 1.1;

        # ---- READ-ONLY: force the method, never forward a body -------------
        proxy_method            $safe_method;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";

        # Host must be derived from the redirect target, NOT set to "".
        # An empty value omits the header entirely -> invalid HTTP/1.1 -> 400.
        # Presigned URL signatures cover Host, so $http_host would also break
        # them with SignatureDoesNotMatch.
        proxy_set_header Host $proxy_host;

        # Never forward head-node credentials to the storage node.
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";

        # Preserve range/resume semantics for large downloads.
        proxy_set_header Range    $http_range;
        proxy_set_header If-Range $http_if_range;

        # ---- TLS to storage (EOS redirect targets are normally HTTPS) ------
        # proxy_ssl_name defaults to $proxy_host, which here is derived from
        # the redirect target -- that is what you want, so leave it unset.
        #
        # NOTE: this hop is NOT yet verified against a real redirect target.
        # If downloads fail with an SSL error while ordinary requests work,
        # the storage node's certificate is the cause.
        proxy_ssl_server_name on;
        proxy_ssl_protocols   TLSv1.2 TLSv1.3;
        proxy_ssl_verify      on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/CERN-Root-2.pem;
        # No CRL here either; see the note on the backend hop above.

        # --- Stream, don't buffer (the important part for big files) --------
        # proxy_buffering          off;
        proxy_request_buffering  off;
        # proxy_max_temp_file_size 0;

        proxy_connect_timeout 10s;
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;

        proxy_redirect ~^https?://[^/]+(/.*)$ $1;

        proxy_buffering on;
        proxy_buffer_size        32k;    # response header from storage
        proxy_buffers            64 64k; # ~4 MB read-ahead per transfer
        proxy_busy_buffers_size  512k;
        proxy_max_temp_file_size 0;      # never touch disk; apply backpressure instead
    }

    location @eos_rate_limit {
        default_type text/plain;
        add_header Retry-After 1 always;
        return 429 "Too many requests, please slow down.\n";
    }

    # Cold storage requests
    location ~ ^/record/[^/]+/(stage|subscribe)$ {
        limit_except GET HEAD POST { deny all; }
        proxy_pass http://web-app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Releases
    location ~ ^/releases/ {
        limit_except GET HEAD POST PUT DELETE { deny all; }
        proxy_pass http://web-app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 100M;
    }

    location / {
        limit_except GET HEAD { deny all; }
        proxy_pass http://web-app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

}
